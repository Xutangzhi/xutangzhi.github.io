{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      &copy; {% if page.lang == 'zh-CN' %}版权所有{% else %}Copyright{% endif %} {{ site.time | date: '%Y' }}
      {% if page.lang == 'zh-CN' %}
        许汤智。
      {% else %}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}.
      {% endif %}
      {% if page.lang == 'zh-CN' %}
        基于 <a href="https://jekyllrb.com/" target="_blank">Jekyll</a> 和 <a href="https://github.com/alshedivat/al-folio">al-folio</a> 构建，由 <a href="https://pages.github.com/" target="_blank">GitHub Pages</a> 托管。
      {% else %}
        {{ site.footer_text }}
      {% endif %}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include scripts/newsletter.liquid %}
    {% endif %}

    <div class="container">
      &copy; {% if page.lang == 'zh-CN' %}版权所有{% else %}Copyright{% endif %} {{ site.time | date: '%Y' }}
      {% if page.lang == 'zh-CN' %}
        许汤智。
      {% else %}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}.
      {% endif %}
      {% if page.lang == 'zh-CN' %}
        基于 <a href="https://jekyllrb.com/" target="_blank">Jekyll</a> 和 <a href="https://github.com/alshedivat/al-folio">al-folio</a> 构建，由 <a href="https://pages.github.com/" target="_blank">GitHub Pages</a> 托管。
      {% else %}
        {{ site.footer_text }}
      {% endif %}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </div>
  </footer>
{% endif %}
