<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.nav_section != 'about' %}
        <a class="navbar-brand title font-weight-lighter" href="{% if page.lang == 'zh-CN' %}{{ '/zh/' | relative_url }}{% else %}{{ '/' | relative_url }}{% endif %}">
          {% if page.lang == 'zh-CN' %}
            <span class="font-weight-bold">徐唐志</span>
          {% elsif site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{% if page.lang == 'zh-CN' %}展开导航{% else %}Toggle navigation{% endif %}"
      >
        <span class="sr-only">{% if page.lang == 'zh-CN' %}展开导航{% else %}Toggle navigation{% endif %}</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% if page.lang == 'zh-CN' %}
            {% assign navigation = site.data.navigation.zh %}
            {% assign current_label = '当前页面' %}
          {% else %}
            {% assign navigation = site.data.navigation.en %}
            {% assign current_label = 'current' %}
          {% endif %}
          {% for item in navigation %}
            <li class="nav-item {% if page.nav_section == item.section %}active{% endif %}">
              <a class="nav-link" href="{{ item.url | relative_url }}">
                {{- item.title -}}
                {% if page.nav_section == item.section %}
                  <span class="sr-only">({{ current_label }})</span>
                {% endif %}
              </a>
            </li>
          {% endfor %}

          <!-- Language switch -->
          <li class="nav-item">
            <a
              class="nav-link"
              href="{{ page.translation | default: '/zh/' | relative_url }}"
              lang="{% if page.lang == 'zh-CN' %}en{% else %}zh-CN{% endif %}"
              hreflang="{% if page.lang == 'zh-CN' %}en{% else %}zh-CN{% endif %}"
            >
              {% if page.lang == 'zh-CN' %}EN{% else %}中文{% endif %}
            </a>
          </li>
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="{% if page.lang == 'zh-CN' %}切换主题{% else %}Change theme{% endif %}">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
